{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-kanban",
  "version": "2.2.5",
  "description": "A persistent Kanban board with capture-to-review pipeline",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugin-kanban"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./board": "./src/board.ts",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "bun check --no-script -p tsconfig.test.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
